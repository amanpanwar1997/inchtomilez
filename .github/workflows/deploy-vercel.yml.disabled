name: Deploy Inchtomilez to Vercel

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-22.04
    timeout-minutes: 45

    steps:
      - name: Checkout website
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm

      - name: Install Chrome dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libnspr4 libnss3 libatk1.0-0 \
            libatk-bridge2.0-0 libgbm1 \
            libasound2 libx11-xcb1 libxcomposite1 \
            libxdamage1 libxrandr2 libxshmfence1 \
            libxkbcommon0 libpango-1.0-0 libcairo2

      - name: Install project dependencies
        run: npm ci --legacy-peer-deps

      - name: Build and prerender SEO pages
        run: npm run build:seo

      - name: Verify required HTML pages
      
        shell: bash
        run: |
          test -f build/index.html
          test -f build/about/index.html
          test -f build/sitemap.xml
          echo "SEO build files verified"

      - name: Prepare Vercel static output
        shell: bash
        run: |
          mkdir -p .vercel/output/static
          cp -a build/. .vercel/output/static/
          node -e 'const fs=require("fs");fs.writeFileSync(".vercel/output/config.json",JSON.stringify({version:3,routes:[{handle:"filesystem"},{src:"^/(.+?)/?$",dest:"/$1/index.html"}]},null,2))'

      - name: Deploy to Vercel Production
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
        run: |
          npx vercel@latest deploy --prebuilt --prod --yes --token="$VERCEL_TOKEN"
