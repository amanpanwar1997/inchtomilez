{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "types": [
      "node"
    ]
  },

  "include": [
    "vite.config.ts"
  ]
}